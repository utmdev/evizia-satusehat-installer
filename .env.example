NODE_ENV=production

# -------------------------------------------------------------------
# 📦 DOCKER REGISTRY PREFIX
# -------------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/your-github-username/satusehat-engine

# -------------------------------------------------------------------
# 🗄️ PILIHAN SKENARIO DATABASE
# -------------------------------------------------------------------
# Skenario 1 (Pakai Database Docker Bawaan):
# COMPOSE_PROFILES=with-db
# DB_HOST=postgresql
#
# Skenario 2 (Pakai Database PostgreSQL Eksternal Milik RS):
# COMPOSE_PROFILES=
# DB_HOST=192.168.1.10 (atau host.docker.internal jika di server host yang sama)
# -------------------------------------------------------------------
COMPOSE_PROFILES=with-db

DB_HOST=postgresql
DB_PORT=5432
DB_NAME=satusehat_engine
DB_USER=satusehat_user
DB_PASSWORD=satusehat_password_123

# -------------------------------------------------------------------
# 🔐 AUTHENTICATION & SECURITY ENCRYPTION
# -------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CONFIG_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# -------------------------------------------------------------------
# 🌐 PORT & DOMAIN
# -------------------------------------------------------------------
API_PORT=3000
WEB_PORT=80
PG_BOSS_SCHEMA=pgboss
CORS_ORIGINS=*

# -------------------------------------------------------------------
# 📡 SIMRS BRIDGING API KEY (Dikirim pada header 'X-SIMRS-API-Key')
# -------------------------------------------------------------------
SIMRS_BRIDGE_API_KEY=replace-with-a-long-random-api-key

# -------------------------------------------------------------------
# 🛡️ RATE LIMITING
# -------------------------------------------------------------------
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_EVENTS_MAX=300
